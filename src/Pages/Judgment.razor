@page "/judgment"
@using SupremeAI.Models
@using SupremeAI.Services
@inject AiApiService AiApi
@inject ILogger<Judgment> Logger

<PageTitle>SupremeAI – Advisory Judgment</PageTitle>

<div class="judgment-shell">

    <!-- ─── Header ─── -->
    <header class="judgment-header">
        <div class="judgment-crown" aria-hidden="true">
            <svg viewBox="0 0 36 28" xmlns="http://www.w3.org/2000/svg" width="36" height="28">
                <polygon points="18,2 34,22 26,18 18,26 10,18 2,22"
                         fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/>
            </svg>
        </div>
        <div>
            <h1 class="judgment-title">Advisory Judgment</h1>
            <p class="judgment-subtitle">
                The system recommends — you choose. Every decision is transparent, logged, and yours.
            </p>
        </div>
    </header>

    <!-- ─── Prompt input ─── -->
    <section class="judgment-query-section">
        <label for="judgment-query" class="judgment-section-title">Your prompt</label>
        <textarea id="judgment-query"
                  class="judgment-query-input"
                  placeholder="Describe your task. SupremeAI will evaluate models and surface a recommendation — you retain the final choice."
                  rows="4"
                  @bind="_query"
                  @bind:event="oninput"
                  disabled="@_isRunning" />
        <button class="judgment-run-btn"
                @onclick="RunJudgment"
                disabled="@(_isRunning || string.IsNullOrWhiteSpace(_query))">
            @if (_isRunning)
            {
                <span class="judgment-spinner" aria-hidden="true"></span>
                <span>Evaluating…</span>
            }
            else
            {
                <svg viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" width="18" height="18" aria-hidden="true">
                    <polygon points="4,2 18,10 4,18" fill="currentColor"/>
                </svg>
                <span>Get Advisory Judgment</span>
            }
        </button>
    </section>

    <!-- ─── Error banner ─── -->
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="judgment-error" role="alert">
            <strong>Error:</strong>
            <pre class="judgment-error-detail">@_errorMessage</pre>
        </div>
    }

    <!-- ─── Advisory recommendation ─── -->
    @if (_judgment is not null)
    {
        var rec = _judgment.Recommendation;

        <section class="advisory-section">
            <div class="advisory-header-row">
                <span class="advisory-title">System Advisory</span>
                <span class="advisory-domain-badge">Domain: @rec.Domain</span>
            </div>
            <p class="advisory-help-text">
                This is a <strong>recommendation</strong>, not a mandate. Review the options below and confirm your choice.
            </p>

            <!-- Primary recommendation -->
            <div class="advisory-card advisory-card--recommended @(_selectedApproach == rec.Recommendation ? "selected" : "")">
                <div class="advisory-card-header">
                    <span class="advisory-recommended-badge">
                        ★ Recommended
                    </span>
                    <span class="advisory-confidence advisory-confidence--@rec.Confidence.ToLowerInvariant()">
                        @rec.Confidence confidence
                    </span>
                </div>
                <div class="advisory-card-approach">@rec.Recommendation</div>

                @if (rec.Reasons.Count > 0)
                {
                    <ul class="advisory-reasons">
                        @foreach (var reason in rec.Reasons)
                        {
                            <li>@reason</li>
                        }
                    </ul>
                }

                @if (!string.IsNullOrWhiteSpace(rec.Caveat))
                {
                    <div class="advisory-caveat">
                        <strong>⚠ Caveat:</strong> @rec.Caveat
                    </div>
                }

                <button class="advisory-select-btn advisory-select-btn--primary"
                        @onclick="() => SelectApproach(rec.Recommendation)"
                        disabled="@(_overrideSubmitted)">
                    @if (_selectedApproach == rec.Recommendation && _overrideSubmitted)
                    {
                        <span>✓ Choice recorded</span>
                    }
                    else
                    {
                        <span>Accept recommendation</span>
                    }
                </button>
            </div>

            <!-- Alternatives -->
            @foreach (var alt in rec.Alternatives)
            {
                <div class="advisory-card advisory-card--alternative @(_selectedApproach == alt.Approach ? "selected" : "")">
                    <div class="advisory-card-header">
                        <span class="advisory-alternative-badge">@alt.Label</span>
                    </div>
                    <div class="advisory-card-approach">@alt.Approach</div>
                    @if (!string.IsNullOrWhiteSpace(alt.Tradeoff))
                    {
                        <div class="advisory-tradeoff">
                            <strong>Trade-off:</strong> @alt.Tradeoff
                        </div>
                    }
                    <button class="advisory-select-btn advisory-select-btn--alt"
                            @onclick="() => SelectApproach(alt.Approach)"
                            disabled="@(_overrideSubmitted)">
                        @if (_selectedApproach == alt.Approach && _overrideSubmitted)
                        {
                            <span>✓ Choice recorded</span>
                        }
                        else
                        {
                            <span>Choose this alternative</span>
                        }
                    </button>
                </div>
            }

            <!-- Override reason input -->
            @if (!string.IsNullOrEmpty(_selectedApproach) && !_overrideSubmitted)
            {
                <div class="advisory-override-form">
                    <label class="judgment-section-title" for="override-reason">
                        Reason for your choice (optional — helps with accountability)
                    </label>
                    <textarea id="override-reason"
                              class="judgment-query-input override-reason-input"
                              placeholder="e.g. 'I prefer the alternative for its faster latency given our deadline.'"
                              rows="2"
                              @bind="_overrideReason"
                              @bind:event="oninput" />
                    <button class="judgment-run-btn advisory-confirm-btn"
                            @onclick="ConfirmChoice"
                            disabled="@_isSubmitting">
                        @if (_isSubmitting)
                        {
                            <span class="judgment-spinner" aria-hidden="true"></span>
                            <span>Recording…</span>
                        }
                        else
                        {
                            <span>Confirm my choice</span>
                        }
                    </button>
                </div>
            }

            <!-- Override confirmation -->
            @if (_overrideSubmitted && _overrideResult is not null)
            {
                var ov = _overrideResult.Override;
                <div class="advisory-recorded" role="status">
                    <div class="advisory-recorded-header">
                        ✓ Your choice has been recorded
                    </div>
                    <div class="advisory-recorded-detail">
                        <span class="advisory-recorded-label">Selected:</span>
                        <span>@ov.SelectedApproach</span>
                    </div>
                    @if (!ov.IsSystemRecommendation)
                    {
                        <div class="advisory-recorded-detail advisory-recorded-override-note">
                            You chose an alternative over the system recommendation.
                            This decision is logged for audit transparency.
                        </div>
                    }
                    else
                    {
                        <div class="advisory-recorded-detail">
                            You confirmed the system recommendation.
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(ov.Reason))
                    {
                        <div class="advisory-recorded-detail">
                            <span class="advisory-recorded-label">Your reason:</span>
                            <span>@ov.Reason</span>
                        </div>
                    }
                    <div class="advisory-recorded-detail advisory-recorded-id">
                        Override ID: <code aria-label="Override identifier">@ov.Id</code>
                    </div>
                </div>
            }
        </section>

        <!-- ─── Winner answer ─── -->
        <section class="judgment-answer-section">
            <div class="judgment-answer-badge">Supreme Answer</div>
            <div class="judgment-answer-rationale">@_judgment.Rationale</div>
            <div class="judgment-answer-text">@_judgment.WinnerAnswer</div>
        </section>
    }

</div>

<!-- ─── Backend unavailable warning ─── -->
@if (_backendUnavailable)
{
    <div class="judgment-api-warning" role="alert">
        <strong>⚠ Backend API unavailable.</strong>
        The SupremeAI API could not be reached. Ensure the API is running and model
        provider keys are configured. See <code>.env.example</code> in the repository.
    </div>
}

<style>
    /* ── Shell ─────────────────────────────────────────────────────────────── */
    .judgment-shell {
        max-width: 820px;
        margin: 0 auto;
        padding: 2rem 1.25rem 4rem;
        font-family: var(--sai-font, system-ui, sans-serif);
        color: var(--sai-fg, #e8e8e8);
    }

    /* ── Header ────────────────────────────────────────────────────────────── */
    .judgment-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2rem;
    }
    .judgment-crown { color: #6ee7b7; flex-shrink: 0; }
    .judgment-title { font-size: 1.75rem; font-weight: 700; margin: 0; }
    .judgment-subtitle { font-size: 0.875rem; color: #aaa; margin: 0.2rem 0 0; }

    /* ── Section titles ─────────────────────────────────────────────────────── */
    .judgment-section-title {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #888;
        margin: 0 0 0.5rem;
        display: block;
    }

    /* ── Query input ────────────────────────────────────────────────────────── */
    .judgment-query-section { margin-bottom: 1.5rem; }
    .judgment-query-input {
        width: 100%;
        background: #1a1a1a;
        border: 1.5px solid #333;
        border-radius: 10px;
        color: #e8e8e8;
        font-size: 0.95rem;
        padding: 0.75rem 1rem;
        resize: vertical;
        box-sizing: border-box;
        transition: border-color 0.15s;
    }
    .judgment-query-input:focus { outline: none; border-color: #6ee7b7; }
    .judgment-run-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 0.75rem;
        padding: 0.55rem 1.4rem;
        background: #6ee7b7;
        color: #111;
        border: none;
        border-radius: 8px;
        font-size: 0.9rem;
        font-weight: 700;
        cursor: pointer;
        transition: opacity 0.15s;
    }
    .judgment-run-btn:disabled { opacity: 0.45; cursor: not-allowed; }
    .judgment-spinner {
        width: 16px; height: 16px;
        border: 2px solid #111;
        border-top-color: transparent;
        border-radius: 50%;
        animation: spin 0.7s linear infinite;
        display: inline-block;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }

    /* ── Error ──────────────────────────────────────────────────────────────── */
    .judgment-error {
        background: #3a1515;
        border: 1px solid #a33;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        margin-bottom: 1.5rem;
        font-size: 0.875rem;
        color: #f88;
    }
    .judgment-error-detail {
        margin: 0.5rem 0 0;
        font-size: 0.75rem;
        line-height: 1.5;
        white-space: pre-wrap;
        overflow-wrap: break-word;
        overflow: auto;
        max-height: 40vh;
        background: #2a0a0a;
        border-radius: 5px;
        padding: 0.5rem 0.75rem;
        color: #f99;
    }

    /* ── Advisory section ───────────────────────────────────────────────────── */
    .advisory-section {
        margin-bottom: 2rem;
    }
    .advisory-header-row {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 0.5rem;
    }
    .advisory-title {
        font-size: 1rem;
        font-weight: 700;
        color: #6ee7b7;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }
    .advisory-domain-badge {
        font-size: 0.72rem;
        background: #1a2a25;
        border: 1px solid #2a4a3a;
        color: #6ee7b7;
        padding: 0.15rem 0.6rem;
        border-radius: 999px;
    }
    .advisory-help-text {
        font-size: 0.82rem;
        color: #888;
        margin-bottom: 1rem;
        line-height: 1.5;
    }

    /* ── Advisory cards ─────────────────────────────────────────────────────── */
    .advisory-card {
        background: #141414;
        border: 1.5px solid #2a2a2a;
        border-radius: 12px;
        padding: 1.1rem 1.25rem;
        margin-bottom: 1rem;
        transition: border-color 0.2s;
    }
    .advisory-card.selected {
        border-color: #6ee7b7;
    }
    .advisory-card--recommended {
        background: linear-gradient(135deg, #0d1f1a 0%, #0d1a15 100%);
        border-color: #2a4a3a;
    }
    .advisory-card--recommended.selected {
        border-color: #6ee7b7;
    }
    .advisory-card-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.6rem;
    }
    .advisory-recommended-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        background: #6ee7b7;
        color: #111;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        padding: 0.2rem 0.6rem;
        border-radius: 999px;
    }
    .advisory-alternative-badge {
        display: inline-flex;
        align-items: center;
        background: #2a2a3a;
        color: #aaa;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        padding: 0.2rem 0.6rem;
        border-radius: 999px;
    }
    .advisory-confidence {
        font-size: 0.72rem;
        padding: 0.15rem 0.5rem;
        border-radius: 999px;
        font-weight: 600;
    }
    .advisory-confidence--high  { background: #1a3a1a; color: #6ee7b7; }
    .advisory-confidence--medium { background: #3a2a00; color: #f0c040; }
    .advisory-confidence--low   { background: #3a1a1a; color: #f08080; }

    .advisory-card-approach {
        font-size: 0.95rem;
        font-weight: 600;
        color: #e8e8e8;
        margin-bottom: 0.6rem;
        line-height: 1.4;
    }
    .advisory-reasons {
        margin: 0 0 0.75rem 1rem;
        padding: 0;
        list-style: disc;
        font-size: 0.82rem;
        color: #bbb;
        line-height: 1.55;
    }
    .advisory-caveat {
        font-size: 0.8rem;
        color: #c8a040;
        background: #2a2000;
        border-left: 3px solid #c8a040;
        padding: 0.4rem 0.75rem;
        border-radius: 4px;
        margin-bottom: 0.75rem;
        line-height: 1.5;
    }
    .advisory-tradeoff {
        font-size: 0.8rem;
        color: #aaa;
        background: #1a1a2a;
        border-left: 3px solid #444;
        padding: 0.4rem 0.75rem;
        border-radius: 4px;
        margin-bottom: 0.75rem;
        line-height: 1.5;
    }

    /* ── Select buttons ─────────────────────────────────────────────────────── */
    .advisory-select-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.4rem 1rem;
        border: 1.5px solid;
        border-radius: 7px;
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.15s, color 0.15s;
    }
    .advisory-select-btn:disabled { opacity: 0.55; cursor: not-allowed; }
    .advisory-select-btn--primary {
        background: transparent;
        border-color: #6ee7b7;
        color: #6ee7b7;
    }
    .advisory-select-btn--primary:hover:not(:disabled) {
        background: #6ee7b7;
        color: #111;
    }
    .advisory-select-btn--alt {
        background: transparent;
        border-color: #555;
        color: #aaa;
    }
    .advisory-select-btn--alt:hover:not(:disabled) {
        background: #333;
        color: #e8e8e8;
    }

    /* ── Override form ──────────────────────────────────────────────────────── */
    .advisory-override-form {
        background: #111;
        border: 1px solid #2a2a2a;
        border-radius: 10px;
        padding: 1rem 1.25rem;
        margin-top: 0.5rem;
        margin-bottom: 1rem;
    }
    .override-reason-input { min-height: 60px; }
    .advisory-confirm-btn  { background: #4a7a6a; color: #e8e8e8; }
    .advisory-confirm-btn:hover:not(:disabled) { background: #5a9a8a; }

    /* ── Override recorded ──────────────────────────────────────────────────── */
    .advisory-recorded {
        background: #0d1f1a;
        border: 1.5px solid #6ee7b7;
        border-radius: 10px;
        padding: 1rem 1.25rem;
        margin-top: 0.75rem;
        margin-bottom: 1rem;
    }
    .advisory-recorded-header {
        font-size: 0.9rem;
        font-weight: 700;
        color: #6ee7b7;
        margin-bottom: 0.6rem;
    }
    .advisory-recorded-detail {
        font-size: 0.8rem;
        color: #aaa;
        line-height: 1.5;
        margin-bottom: 0.3rem;
    }
    .advisory-recorded-label {
        font-weight: 600;
        color: #888;
        margin-right: 0.4rem;
    }
    .advisory-recorded-override-note {
        color: #f0c040;
        font-style: italic;
    }
    .advisory-recorded-id {
        font-size: 0.7rem;
        color: #555;
        font-family: monospace;
        margin-top: 0.5rem;
    }

    /* ── Winner answer ──────────────────────────────────────────────────────── */
    .judgment-answer-section {
        background: #141414;
        border: 1.5px solid #2a2a2a;
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
        margin-bottom: 2rem;
    }
    .judgment-answer-badge {
        display: inline-block;
        background: #333;
        color: #aaa;
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: 0.2rem 0.6rem;
        border-radius: 999px;
        margin-bottom: 0.75rem;
    }
    .judgment-answer-rationale {
        font-size: 0.78rem;
        color: #666;
        margin-bottom: 0.75rem;
        line-height: 1.5;
        font-style: italic;
    }
    .judgment-answer-text {
        font-size: 0.95rem;
        line-height: 1.65;
        white-space: pre-wrap;
        color: #e8e8e8;
    }

    /* ── API unavailable warning ─────────────────────────────────────────────── */
    .judgment-api-warning {
        max-width: 820px;
        margin: 1rem auto;
        padding: 0.75rem 1.25rem;
        background: #2a1800;
        border: 1.5px solid #a05000;
        border-radius: 10px;
        font-size: 0.85rem;
        color: #f0a050;
        line-height: 1.7;
    }
    .judgment-api-warning strong { color: #ffc875; }
    .judgment-api-warning code {
        background: #1a1000;
        border-radius: 4px;
        padding: 0.1rem 0.35rem;
        font-size: 0.78rem;
        color: #ffc875;
    }
</style>

@code {
    private string _query = "";
    private bool   _isRunning;
    private bool   _isSubmitting;
    private bool   _backendUnavailable;
    private string? _errorMessage;

    private ApiJudgmentRecord?  _judgment;
    private string?             _selectedApproach;
    private string              _overrideReason = "";
    private bool                _overrideSubmitted;
    private ApiOverrideResponse? _overrideResult;

    private async Task RunJudgment()
    {
        if (string.IsNullOrWhiteSpace(_query)) return;

        _isRunning        = true;
        _errorMessage     = null;
        _judgment         = null;
        _selectedApproach = null;
        _overrideReason   = "";
        _overrideSubmitted = false;
        _overrideResult   = null;
        _backendUnavailable = false;
        StateHasChanged();

        try
        {
            var response = await AiApi.JudgeAsync(_query);

            if (response is not null)
            {
                _judgment = response.Judgment;
            }
            else
            {
                _backendUnavailable = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error during advisory judgment");
            _errorMessage = ex.Message;
        }
        finally
        {
            _isRunning = false;
        }
    }

    private void SelectApproach(string approach)
    {
        if (_overrideSubmitted) return;
        _selectedApproach = approach;
    }

    private async Task ConfirmChoice()
    {
        if (_judgment is null || string.IsNullOrEmpty(_selectedApproach)) return;

        _isSubmitting = true;
        StateHasChanged();

        try
        {
            var reason = string.IsNullOrWhiteSpace(_overrideReason) ? null : _overrideReason;
            var result = await AiApi.SubmitOverrideAsync(_judgment.Id, _selectedApproach, reason);

            if (result is not null)
            {
                _overrideResult    = result;
                _overrideSubmitted = true;
            }
            else
            {
                _errorMessage = "Could not record your choice. Please try again.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error submitting override for judgment {Id}", _judgment.Id);
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
